#!name=YouTube Gemini 中文字幕
#!desc=油管各语种字幕用 Gemini AI 翻成中文，只显示中文，比免费谷歌翻译准。Key 已内置，装好直接用
#!author=奶蛙
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Script]
YouTube-Gemini-Subs = type=http-response, pattern=^https://(www|m)\.youtube\.com/api/timedtext\?.*fmt=json3, requires-body=1, max-size=1048576, script-path=https://raw.githubusercontent.com/kikyou1w-lab/egern-config/main/youtube-gemini-subs.js, argument=API_KEY=请粘贴你的Gemini-API-Key

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
